# Legacy single-key config. Still supported.
GEMINI_API_KEY=

# Alternative to GEMINI_API_KEY for multi-project rotation (comma-separated alias:key).
# Gemini limits are per PROJECT, so each entry should use a separate GCP project.
GEMINI_CREDENTIALS=projA:your_key_here,projB:your_other_key_here
GEMINI_MODEL_CHAIN=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite

# Optional free fallback (https://console.groq.com). Leave blank to disable.
GROQ_API_KEY=
GROQ_MODEL_CHAIN=llama-3.3-70b-versatile,openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

MAX_INPUT_CHARS=24000
MAX_PDF_PAGES=60
MAX_CARDS=20
MAX_LEECHES_PER_CALL=8
MAX_OUTPUT_TOKENS=4096
GROQ_MAX_INPUT_CHARS=12000

CACHE_ENABLED=true
CACHE_DIR=/tmp/flutterstudy_cache
PROMPT_VERSION=v2